# ===== LINE Messaging API チャネル =====
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== LIFF（LINE Login チャネル）: 任意 =====
# 設定するとダッシュボードが LINE ログイン済みの状態で開ける（誰が完了したかも自動記録）
LIFF_ID=
LINE_LOGIN_CHANNEL_ID=

# ===== アプリ設定 =====
# デプロイ先の URL（末尾スラッシュなし）。メッセージ内のダッシュボードリンクに使う
BASE_URL=http://localhost:8000
# 未設定ならローカルの SQLite。Render 等では Supabase / Neon の Postgres URL を推奨
DATABASE_URL=sqlite:///./chore_bot.db
# /cron/* を叩くための合言葉（長いランダム文字列にする）
CRON_SECRET=change-me
# LIFF を使わずにブラウザからダッシュボードを開くときの合言葉（?key=... で渡す）
DASHBOARD_KEY=change-me-too
# LIFF 利用時に操作を許可する LINE ユーザーID（カンマ区切り, 空なら制限なし）
ALLOWED_USER_IDS=
TIMEZONE=Asia/Tokyo
